# rss.gowoobro.com — FreshRSS 리버스 프록시 (HTTPS)
# 기존 nginx 설정 스타일에 맞춰 server 블록만 추가하면 된다.
# SSL 인증서는 늘 쓰시던 certbot 방식으로 발급 (standalone 또는 webroot).

server {
    listen 80;
    server_name rss.gowoobro.com;
    # 인증서 발급용 챌린지 경로가 있으면 유지, 나머지는 HTTPS로 리다이렉트
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name rss.gowoobro.com;

    ssl_certificate     /etc/letsencrypt/live/rss.gowoobro.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rss.gowoobro.com/privkey.pem;

    # FreshRSS는 docker에서 127.0.0.1:8085로 떠 있음
    location / {
        proxy_pass http://127.0.0.1:8085;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
