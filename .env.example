# 복사해서 .env 로 저장하고 값을 채우세요.  (cp .env.example .env)
# ⚠️ 실제 값(.env)은 절대 커밋/이미지 포함 금지 — 이 파일(.env.example)엔 예시만.
#
# ⚠️ docker --env-file 규칙: 값 뒤 인라인 주석(VAR=값 # 주석)은 값에 섞여 들어간다.
#    주석은 반드시 이렇게 '독립된 줄'(# 로 시작)에만 쓸 것. 값 줄엔 주석 금지.

# ── FreshRSS ──────────────────────────────────────────────
FRESHRSS_BASE=https://rss.gowoobro.com
FRESHRSS_USER=여기에_FreshRSS_사용자명
# FRESHRSS_API_PASSWORD: 로그인 비번 아님! 프로필 > 인증 > API 비밀번호
FRESHRSS_API_PASSWORD=여기에_API_비밀번호

# ── Claude Code 인증 (요약 엔진, 구독 → API 과금 0) ──────────
# `claude setup-token` 실행 → 나온 sk-ant-oat01-... 토큰을 붙여넣기.
# 컨테이너의 claude -p 가 이 토큰으로 인증한다 (별도 볼륨 마운트 불필요).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-여기에_본인_토큰
# 컨테이너 안 기본값 claude 그대로 두면 됨
CLAUDE_BIN=claude
# 요약 모델. 비우면 기본 모델. 예: claude-haiku-4-5-20251001
CLAUDE_MODEL=

# ── Notion ────────────────────────────────────────────────
# notion.so/my-integrations 에서 통합 생성 → Internal Integration Token.
# 그리고 "Reeder 읽기 요약" DB 를 그 통합과 연결(··· > Connections).
NOTION_TOKEN=ntn_여기에_본인_토큰
# "Reeder 읽기 요약" DB (이미 채워둠)
NOTION_DB_ID=ba591c8b4bda4127b1a75fa6dc455f85

# ── 동작 옵션 ──────────────────────────────────────────────
# 한 번에 요약할 글 최대 개수. 넘친 글은 다음 실행에서 이어서 처리한다.
MAX_ITEMS=40
# 1=처리한 글을 FreshRSS 에서 읽음으로 바꿔 Reeder 를 비운다. 0=읽음 상태를 건드리지 않는다.
# 무엇을 요약할지는 읽음 여부와 무관하다 (지난 실행 뒤에 들어온 글 전부).
MARK_READ=1
# 처음 실행(저장된 커서 없음)일 때 몇 시간 전부터 들어온 글을 볼지. 그 뒤로는 커서가 기준.
LOOKBACK_HOURS=24
# 발행된 지 이 일수가 넘은 글은 요약하지 않는다.
# 블로그가 주소를 옮기면 FreshRSS 가 예전 글 전체를 새 글로 다시 받아 오는데, 그걸 걸러낸다.
# 0 이면 끈다(모든 글을 요약). 쌓인 옛 글까지 요약하고 싶을 때만 0 으로.
MAX_AGE_DAYS=30

# 처리 없이 목록만 보려면 실행할 때 -e DRY_RUN=1 을 붙인다 (여기에 적어 두지 말 것).

# SEEN_FILE 은 설정하지 마세요. (커서 파일 freshrss_digest_state.json 도 같은 폴더에 생긴다)
#   - Docker: Dockerfile 이 /data/freshrss_digest_seen.json 로 지정(볼륨)
#   - 호스트 직접 실행: 미설정 시 ~/.freshrss_digest_seen.json 기본값
# 여기서 값을 주면 컨테이너의 /data 경로를 덮어써 깨집니다.
